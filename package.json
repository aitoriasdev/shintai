{
  "name": "shintai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors magenta,cyan \"yarn dev:api\" \"yarn dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --tsconfig tsconfig.server.json server/main.ts",
    "build": "tsc -b && vite build",
    "start": "yarn build && yarn serve",
    "serve": "tsx --tsconfig tsconfig.server.json server/main.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint && steiger ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "openapi": "tsx --tsconfig tsconfig.server.json server/openapi/write-openapi-document.ts",
    "check": "yarn typecheck && yarn lint && yarn test && yarn test:e2e"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@tanstack/react-query": "^5.108.4",
    "hono": "^4.13.23",
    "lucide-react": "^1.82.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.95.0",
    "playwright": "^1.65.1",
    "playwright-core": "^1.65.1",
    "steiger": "^0.10.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vitest-browser-react": "^2.3.0"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba",
  "engines": {
    "node": ">=24"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": false
    }
  }
}
